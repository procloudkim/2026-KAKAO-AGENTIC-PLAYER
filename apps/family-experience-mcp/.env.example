# Local development template only.
# Copy to .env for local use. Do not commit .env or paste provider-issued keys here.
#
# Deployment rule:
# - Local: put provider-issued keys in .env only.
# - KakaoCloud/PlayMCP-in-KC: prefer platform env or Secret injection when available.
# - Non-Kakao hosts: put provider-issued keys in the host secret manager as env vars.
# - Image-baked keys are never the default. They require HUMAN_APPROVAL_REQUIRED in the runbook.
#
# Secret variables: set these only in .env or a deployment secret manager.
SEOUL_OPEN_DATA_KEY=
# The direct Seoul Open Data endpoint is excluded from the production path until an HTTPS transport is confirmed.
SEOUL_OPEN_DATA_BASE_URL=
CULTURE_PORTAL_SERVICE_KEY=
CULTURE_PORTAL_BASE_URL=https://apis.data.go.kr/B553457/cultureinfo
KTO_TOURAPI_SERVICE_KEY=
KTO_TOURAPI_BASE_URL=https://apis.data.go.kr/B551011/KorService2
PUBLIC_DATA_STANDARD_SERVICE_KEY=

# Non-secret runtime/config variables: safe defaults or plain deployment env vars.
NATIONAL_CULTURE_FESTIVAL_BASE_URL=
NATIONAL_CULTURE_FESTIVAL_CSV_PATH=공공데이터-관련/전국문화축제표준데이터.csv
FAMILY_EXPERIENCE_SOURCE_SET=kto_tourapi
FAMILY_EXPERIENCE_ETL_CACHE_DIR=data/family-experience-cache
FAMILY_EXPERIENCE_ETL_MAX_PAGES=1
FAMILY_EXPERIENCE_ETL_TTL_HOURS=24
# A validated live cache may be served with a visible degraded-data notice for this many
# additional hours. Runtime validation caps this value at 168 hours.
FAMILY_EXPERIENCE_ETL_STALE_GRACE_HOURS=24
FAMILY_EXPERIENCE_ALLOW_FIXTURE=false
FAMILY_EXPERIENCE_MCP_RATE_LIMIT=60
FAMILY_EXPERIENCE_MCP_RATE_WINDOW_MS=60000
# Public metadata required before /privacy returns publication-ready HTTP 200.
FAMILY_EXPERIENCE_OPERATOR_NAME=
FAMILY_EXPERIENCE_PRIVACY_CONTACT=
HOST=127.0.0.1
PORT=3349
